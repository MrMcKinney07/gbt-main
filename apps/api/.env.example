# Copy to .env for local dev. Never commit a real .env.

DATABASE_URL=postgres://gbt_app:gbt_app_dev_only@localhost:5432/gbt
PORT=3001
HOST=0.0.0.0

# JWT secrets - dev-only values, rotate for anything beyond a local demo.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Watchdog tuning (all demo-friendly short windows; see README "what's simplified").
# Production would use the 10-45 min hard bounds from db/migrations/0007 + section 8.2.
WATCHDOG_POLL_INTERVAL_SECONDS=10
WATCHDOG_IDLE_WARNING_SECONDS=60
WATCHDOG_WELLNESS_CHECK_DELAY_SECONDS=30
WATCHDOG_ESCALATION_DELAY_SECONDS=60
WATCHDOG_MOVEMENT_RADIUS_THRESHOLD_M=40

# Photo storage (local disk stub - see README).
PHOTO_STORAGE_DIR=.data/photos
